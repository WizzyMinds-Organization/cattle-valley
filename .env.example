NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key"
# Server-only — never prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
# Google Apps Script Web App exec URL — the contact form forwards each
# submission here; the script appends a row to a Google Sheet and emails
# info@cattlevalley.com. Optional: if unset, submissions still save to
# Supabase and show up in the admin panel, just skip the sheet/email step.
CONTACT_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/your-deployment-id/exec"
